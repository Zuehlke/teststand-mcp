<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>TestStandMCP.IntegrationTests</RootNamespace>
    <AssemblyName>TestStandMCP.IntegrationTests</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Source files from main project compiled directly (main project OutputType=Exe has no DLL) -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Auto-apply the run settings (DisableAppDomain) for both `dotnet test` and the VS Test
         Explorer, so the COM-engine teardown no longer hangs the host on a child-AppDomain unload.
         Removes the need to pass the settings flag on the command line. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <!-- ── Source files shared from main project ─────────────────────────── -->
  <ItemGroup>
    <Compile Include="..\..\src\Models\TestStandModels.cs"   Link="Shared\TestStandModels.cs" />
    <Compile Include="..\..\src\Models\McpModels.cs"         Link="Shared\McpModels.cs" />
    <Compile Include="..\..\src\Services\TestStandService.cs" Link="Shared\TestStandService.cs" />
    <Compile Include="..\..\src\Services\TestStandInstallLocator.cs" Link="Shared\TestStandInstallLocator.cs" />
    <Compile Include="..\..\src\Services\SequenceEditorService.cs" Link="Shared\SequenceEditorService.cs" />
    <Compile Include="..\..\src\Tools\SequencePlanValidator.cs" Link="Shared\SequencePlanValidator.cs" />
    <Compile Include="..\..\src\Tools\InputGuards.cs" Link="Shared\InputGuards.cs" />
    <Compile Include="..\..\src\Tools\ReferenceAuditor.cs" Link="Shared\ReferenceAuditor.cs" />
    <Compile Include="..\..\src\Tools\ExpressionReference.cs" Link="Shared\ExpressionReference.cs" />
    <Compile Include="..\..\src\Tools\SchemaBuilder.cs" Link="Shared\SchemaBuilder.cs" />
    <Compile Include="..\..\src\Tools\DiffReportShaper.cs" Link="Shared\DiffReportShaper.cs" />
    <Compile Include="..\..\src\Tools\SequenceModelIo.cs" Link="Shared\SequenceModelIo.cs" />
    <Compile Include="..\..\src\Tools\StepCopyPolicy.cs" Link="Shared\StepCopyPolicy.cs" />
    <Compile Include="..\..\src\Tools\TypeConsistencyAuditor.cs" Link="Shared\TypeConsistencyAuditor.cs" />
    <Compile Include="..\..\src\Tools\TestStandToolRegistry.cs" Link="Shared\TestStandToolRegistry.cs" />
  </ItemGroup>

  <!-- ── NuGet packages ────────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="NUnit"                                       Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter"                           Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"                     Version="17.8.0" />
    <PackageReference Include="Microsoft.CSharp"                           Version="4.7.0" />
    <PackageReference Include="Microsoft.Extensions.Logging"               Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console"       Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"  Version="8.0.2" />
  </ItemGroup>

  <!-- ── TestStand interop (same netstandard2.0 NuGet as the main project) ── -->
  <!-- The test host connects to the TestStand engine in AssemblySetup, so the testhost's
       runtimeconfig MUST declare the same two shared frameworks the engine requires when it
       loads the .NET Core runtime in-process (WindowsDesktop.App also supplies `stdole`). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NationalInstruments.TestStand.API" Version="23.0.0" />
  </ItemGroup>

</Project>
