  "neverAllow": {
    "analyze_sequence_file": "starts AnalyzerApp.exe and writes an analyzer project to disk",
    "compare_sequence_files": "its native mode starts FileDiffer.exe and writes temp files",
    "diff_sequence_files": "starts FileDiffer.exe and writes temp files",
    "evaluate_expression": "an expression can assign, so it can change engine or file state",
    "evaluate_in_thread_context": "an expression can assign, so it can change the state of a live execution",
    "find_file": "the engine can raise a modal prompt that parks the call",
    "run_sequence_analyzer": "starts AnalyzerApp.exe and writes an analyzer project to disk"
  },
  "audit": {
    "find_in_file": {
      "decision": "allow",
      "reason": "Runs the engine search over ONE sequence file already loaded by GetOrLoadSeqFile; the handler passes no replacement and saves nothing. It opens no file other than a sequence file (a non-sequence path fails to load)."
    },
    "get_report_text": {
      "decision": "allow",
      "reason": "Reads Execution.ReportText of an execution held in memory; it takes an execution id, never a path."
    },
    "get_step_unique_id": {
      "decision": "allow",
      "reason": "Reads Step.UniqueStepId with no setter, no save and no execution; the only engine-side effect is the file load every get_* file tool shares."
    },
    "read_csv_lines": {
      "decision": "prompt",
      "reason": "Opens the CSV input record stream on ANY path the caller names and returns its lines, so it is an arbitrary file read and not a read of a TestStand file."
    }
  },
